Group {
  Anchor: (Left: 0, Top: 0, Width: 1920, Height: 1080);

  Panel #Panel {
    Anchor: (Left: 24, Top: 120, Width: 320, Height: 480);
    Background: #1a2332;
  }

  Panel #Accent {
    Anchor: (Left: 24, Top: 120, Width: 4, Height: 480);
    Background: #c94a4a;
  }

  Label #TitleLabel {
    Anchor: (Left: 40, Top: 132, Width: 280, Height: 28);
    Text: "Damage Dealt";
    Style: (FontSize: 18, TextColor: #f3f7ff, RenderBold: true);
  }

  Label #Level {
    Anchor: (Left: 0, Top: 0, Width: 0, Height: 0);
    Visible: false;
    Text: "";
  }

  ProgressBar #ProgressBar {
    Anchor: (Left: 0, Top: 0, Width: 0, Height: 0);
    Visible: false;
  }

  ProgressBar #ProgressBarEffect {
    Anchor: (Left: 0, Top: 0, Width: 0, Height: 0);
    Visible: false;
  }

